<view class="container">
  <view class="header-card card">
    <view class="header-icon">⏰</view>
    <view class="header-title">智能复习提醒</view>
    <view class="header-desc">根据艾宾浩斯遗忘曲线，科学安排复习时间</view>
    
    <view class="review-stats">
      <view class="stat-item">
        <view class="stat-number urgent">{{urgentCount}}</view>
        <view class="stat-label">待复习</view>
      </view>
      <view class="stat-item">
        <view class="stat-number">{{todayCount}}</view>
        <view class="stat-label">今日复习</view>
      </view>
      <view class="stat-item">
        <view class="stat-number">{{masteredCount}}</view>
        <view class="stat-label">已掌握</view>
      </view>
    </view>
  </view>

  <view wx:if="{{todayList.length > 0}}" class="today-section">
    <view class="section-header">
      <text class="section-title">今日待复习</text>
      <view class="review-btn" bindtap="startTodayReview">
        开始复习 ({{todayList.length}}题)
      </view>
    </view>

    <view wx:for="{{todayList}}" wx:key="id" class="question-card card" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="question-header">
        <view class="subject-tag" style="background: {{getSubjectColor(item.subject)}}">
          {{getSubjectIcon(item.subject)}} {{getSubjectName(item.subject)}}
        </view>
        <view class="urgent-tag" wx:if="{{item.isUrgent}}">紧急</view>
      </view>

      <view class="question-content">
        <text class="question-text">{{item.question}}</text>
      </view>

      <view class="question-footer">
        <view class="review-info">
          <text>已复习 {{item.reviewCount || 0}} 次</text>
          <text class="next-review">下次: {{item.nextReviewText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{upcomingList.length > 0}}" class="upcoming-section">
    <view class="section-header">
      <text class="section-title">即将到来</text>
    </view>

    <view wx:for="{{upcomingList}}" wx:key="id" class="question-card card" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="question-header">
        <view class="subject-tag" style="background: {{getSubjectColor(item.subject)}}">
          {{getSubjectIcon(item.subject)}} {{getSubjectName(item.subject)}}
        </view>
        <view class="date-tag">{{item.nextReviewText}}</view>
      </view>

      <view class="question-content">
        <text class="question-text">{{item.question}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{todayList.length === 0 && upcomingList.length === 0}}" class="empty-state">
    <view class="empty-icon">🎉</view>
    <view class="empty-text">太棒了！所有错题都已按时复习</view>
  </view>

  <view class="memory-section card">
    <view class="section-title">🧠 艾宾浩斯遗忘曲线</view>
    <view class="memory-curve">
      <view class="curve-points">
        <view wx:for="{{memoryPoints}}" wx:key="day" class="point-item">
          <view class="point-day">第{{item.day}}天</view>
          <view class="point-bar" style="height: {{item.retention}}%"></view>
          <view class="point-retention">{{item.retention}}%</view>
        </view>
      </view>
    </view>

    <view class="interval-info">
      <view class="interval-title">复习间隔建议</view>
      <view class="interval-list">
        <view wx:for="{{intervals}}" wx:key="index" class="interval-item">
          <text class="interval-number">第{{item + 1}}次</text>
          <text class="interval-days">{{reviewIntervals[item]}}天后</text>
        </view>
      </view>
    </div>
  </view>

  <view class="setting-section card">
    <view class="section-title">⚙️ 提醒设置</view>
    
    <view class="setting-row">
      <text class="setting-label">每日提醒时间</text>
      <picker mode="time" value="{{remindTime}}" bindchange="onTimeChange">
        <view class="setting-value">{{remindTime}}</view>
      </picker>
    </view>

    <view class="setting-row">
      <text class="setting-label">开启复习提醒</text>
      <switch checked="{{remindEnabled}}" bindchange="onSwitchChange" color="#4A90E2"/>
    </view>
  </view>
</view>
