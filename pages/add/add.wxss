.method-buttons {
  display: flex;
  justify-content: space-around;
}

.method-btn {
  text-align: center;
  padding: 30rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  flex: 1;
  margin: 0 10rpx;
  transition: all 0.3s;
}

.method-btn.active {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
}

.method-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.method-text {
  font-size: 26rpx;
}

.photo-area {
  width: 100%;
  min-height: 300rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
}

.photo-placeholder {
  text-align: center;
}

.placeholder-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.placeholder-text {
  color: #999;
  font-size: 28rpx;
}

.preview-image {
  width: 100%;
  border-radius: 16rpx;
}

.image-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reselect-btn {
  font-size: 26rpx;
  color: #4A90E2;
  background: transparent;
  padding: 0;
}

.ocr-tip {
  font-size: 24rpx;
  color: #999;
}

.voice-area {
  text-align: center;
  padding: 40rpx 0;
}

.record-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 30rpx;
  transition: all 0.3s;
}

.record-btn.recording {
  background: #E74C3C;
  color: #fff;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.record-icon {
  font-size: 48rpx;
}

.record-text {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.voice-status {
  font-size: 26rpx;
  color: #666;
}

.recording-text {
  color: #E74C3C;
}

.recorded-text {
  color: #2ECC71;
}

.tip-text {
  color: #999;
}

.question-textarea, .answer-textarea {
  width: 100%;
  min-height: 150rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.picker-row {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #666;
  width: 140rpx;
  flex-shrink: 0;
}

.picker-value {
  flex: 1;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.picker-value.placeholder {
  color: #999;
}

.knowledge-section {
  margin-top: 20rpx;
}

.knowledge-tags {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0;
}

.knowledge-tag {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  color: #666;
}

.knowledge-tag.active {
  background: #4A90E2;
  color: #fff;
}

.custom-knowledge {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.custom-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-right: 20rpx;
}

.add-tag-btn {
  background: #4A90E2;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.selected-tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.selected-tag {
  background: #E3F2FD;
  color: #4A90E2;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-left: 12rpx;
  margin-bottom: 12rpx;
}

.error-reason-section, .difficulty-section {
  margin-bottom: 30rpx;
}

.reason-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.reason-tag {
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  color: #666;
}

.reason-tag.active {
  background: #4A90E2;
  color: #fff;
}

.difficulty-stars {
  display: flex;
  margin-top: 16rpx;
}

.star {
  font-size: 40rpx;
  margin-right: 16rpx;
  opacity: 0.3;
}

.star.active {
  opacity: 1;
}

.submit-section {
  padding: 40rpx 0 80rpx;
}

.submit-btn {
  width: 100%;
}
