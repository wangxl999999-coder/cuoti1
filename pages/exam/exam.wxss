.start-section {
  text-align: center;
  padding: 60rpx 40rpx;
}

.exam-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.exam-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.exam-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 50rpx;
}

.setting-section {
  text-align: left;
}

.setting-row {
  margin-bottom: 30rpx;
}

.setting-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.setting-buttons {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.count-btn, .time-btn {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.count-btn.active, .time-btn.active {
  background: #4A90E2;
  color: #fff;
}

.tag-scroll {
  white-space: nowrap;
}

.available-text {
  color: #999;
  font-size: 26rpx;
  margin: 30rpx 0;
}

.start-btn {
  width: 100%;
}

.exam-header {
  margin-bottom: 20rpx;
}

.header-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.header-item {
  text-align: center;
}

.header-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.header-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.header-value.warning {
  color: #E74C3C;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.progress-bar {
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #357ABD);
  transition: width 0.3s;
}

.question-card {
  margin-bottom: 20rpx;
}

.question-header {
  margin-bottom: 20rpx;
}

.subject-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  color: #fff;
  font-size: 26rpx;
}

.question-image {
  margin-bottom: 20rpx;
}

.question-image image {
  width: 100%;
  border-radius: 12rpx;
}

.question-text {
  font-size: 32rpx;
  line-height: 1.7;
  color: #333;
}

.answer-card {
  margin-bottom: 20rpx;
}

.answer-input {
  width: 100%;
  min-height: 200rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.exam-actions {
  display: flex;
  gap: 20rpx;
}

.nav-btn {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.nav-btn[disabled] {
  opacity: 0.5;
}

.submit-btn {
  flex: 1.5;
}

.result-section {
  text-align: center;
  padding: 60rpx 40rpx;
}

.result-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
}

.score-display {
  margin-bottom: 50rpx;
}

.score-number {
  font-size: 80rpx;
  font-weight: bold;
  color: #4A90E2;
}

.score-unit {
  font-size: 32rpx;
  color: #666;
  margin-left: 10rpx;
}

.result-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 50rpx;
}

.result-stats .stat-item {
  text-align: center;
}

.result-stats .stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.result-stats .stat-label {
  font-size: 26rpx;
  color: #666;
}

.result-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.review-btn {
  background: #E3F2FD;
  color: #4A90E2;
}

.retry-btn {
  background: #F0FFF4;
  color: #2ECC71;
}

.review-header {
  margin-bottom: 20rpx;
}

.review-card {
  margin-bottom: 20rpx;
}

.review-number {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A90E2;
  margin-bottom: 16rpx;
}

.answer-block {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.answer-block.correct {
  background: #F0FFF4;
}

.answer-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.answer-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.back-btn {
  width: 100%;
  margin-top: 20rpx;
  margin-bottom: 60rpx;
}
