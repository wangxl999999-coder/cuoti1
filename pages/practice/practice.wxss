.progress-section {
  margin-bottom: 20rpx;
}

.progress-text {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 12rpx;
  background: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #357ABD);
  transition: width 0.3s;
}

.question-card {
  margin-bottom: 20rpx;
}

.question-header {
  margin-bottom: 20rpx;
}

.subject-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  color: #fff;
  font-size: 26rpx;
}

.question-image {
  margin-bottom: 20rpx;
}

.question-image image {
  width: 100%;
  border-radius: 12rpx;
}

.question-text {
  font-size: 32rpx;
  line-height: 1.7;
  color: #333;
  margin-bottom: 20rpx;
}

.knowledge-tags {
  display: flex;
  flex-wrap: wrap;
}

.knowledge-tag {
  background: #E3F2FD;
  color: #4A90E2;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
}

.answer-section {
  margin-bottom: 20rpx;
}

.wrong-title, .correct-title {
  font-size: 30rpx;
  font-weight: 600;
}

.wrong-answer {
  font-size: 28rpx;
  line-height: 1.7;
  color: #E74C3C;
  padding: 20rpx;
  background: #FFF5F5;
  border-radius: 12rpx;
}

.divider {
  height: 2rpx;
  background: #eee;
  margin: 30rpx 0;
}

.correct-answer {
  font-size: 28rpx;
  line-height: 1.7;
  color: #2ECC71;
  padding: 20rpx;
  background: #F0FFF4;
  border-radius: 12rpx;
}

.action-buttons {
  margin-bottom: 20rpx;
}

.show-answer-btn {
  width: 100%;
}

.answer-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.wrong-btn {
  background: #FFF5F5;
  color: #E74C3C;
}

.correct-btn {
  background: #F0FFF4;
  color: #2ECC71;
}

.nav-buttons {
  display: flex;
  gap: 20rpx;
}

.nav-btn {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.nav-btn[disabled] {
  opacity: 0.5;
}

.select-section {
  margin-top: 20rpx;
}

.filter-row {
  margin-bottom: 24rpx;
}

.filter-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.tag-scroll {
  white-space: nowrap;
}

.tag-scroll .tag {
  display: inline-block;
  margin-right: 12rpx;
}

.question-select-list {
  max-height: 600rpx;
  overflow-y: auto;
  margin-bottom: 30rpx;
}

.select-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #eee;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.select-item.selected {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-color: #4A90E2;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.2);
  transform: translateY(-2rpx);
}

.select-checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: transparent;
  background: #fff;
  transition: all 0.3s;
}

.select-item.selected .select-checkbox {
  background: #4A90E2;
  border-color: #4A90E2;
  color: #fff;
}

.select-content {
  flex: 1;
}

.select-subject {
  font-size: 24rpx;
  margin-bottom: 8rpx;
  transition: all 0.3s;
}

.subject-icon {
  margin-right: 8rpx;
}

.subject-name {
  color: #999;
  transition: all 0.3s;
}

.select-item.selected .subject-name {
  color: #4A90E2;
  font-weight: 600;
}

.select-text {
  font-size: 28rpx;
  color: #999;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  transition: all 0.3s;
}

.select-item.selected .select-text {
  color: #333;
  font-weight: 500;
}

.start-practice-btn {
  width: 100%;
}

.completed-section {
  text-align: center;
  padding: 60rpx 40rpx;
}

.completed-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.completed-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
}

.completed-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 50rpx;
}

.completed-stats .stat-item {
  text-align: center;
}

.completed-stats .stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-bottom: 10rpx;
}

.completed-stats .stat-label {
  font-size: 26rpx;
  color: #666;
}

.back-btn {
  width: 100%;
}
